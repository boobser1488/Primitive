// time — измерение времени и его запись словами.
//
// Подключение:
//     import "time" as time
//     часы = time.start()
//     ... работа ...
//     print(time.since(часы))
//
// Часы отсчитывают миллисекунды от какого-то мгновения в прошлом; какого
// именно — не оговорено, поэтому осмысленна только разница между двумя
// отсчётами, а не сам отсчёт.

import "strings" as strings
import "math" as math

/// Отсчёт для начала измерения.
function start() {
    return clock()
}

/// Сколько миллисекунд прошло с отсчёта.
function since(начало) {
    return clock() - начало
}

/// Ждать заданное число миллисекунд.
function pause(мс) {
    sleep(мс)
    return null
}

/// Сколько миллисекунд заняла работа. Работа зовётся без доводов.
function measure(работа) {
    начало = clock()
    работа()
    return clock() - начало
}

/// Лучшее из нескольких прогонов. Одиночный замер сильно скачет, а лучшее
/// ближе всего к тому, во что работа обходится на самом деле.
function best_of(работа, прогонов) {
    лучшее = -1
    i = 0
    while i < прогонов {
        д = measure(работа)
        if лучшее < 0 or д < лучшее {
            лучшее = д
        }
        i = i + 1
    }
    return лучшее
}

/// Миллисекунды словами: 90061000 превращается в «1 д 1 ч 1 мин 1 с».
function humanize(мс) {
    if мс < 1000 {
        return "" + мс + " мс"
    }
    всего = мс / 1000
    дней = всего / 86400
    остаток = всего % 86400
    часов = остаток / 3600
    остаток = остаток % 3600
    минут = остаток / 60
    секунд = остаток % 60

    части = []
    if дней > 0 {
        push(части, "" + дней + " д")
    }
    if часов > 0 {
        push(части, "" + часов + " ч")
    }
    if минут > 0 {
        push(части, "" + минут + " мин")
    }
    if секунд > 0 or length(части) == 0 {
        push(части, "" + секунд + " с")
    }
    return join(части, " ")
}

/// Часы, минуты и секунды через двоеточие: 3661000 даёт «01:01:01».
function clock_face(мс) {
    всего = мс / 1000
    часов = всего / 3600
    минут = (всего % 3600) / 60
    секунд = всего % 60
    return _два(часов) + ":" + _два(минут) + ":" + _два(секунд)
}

function _два(n) {
    return strings.pad_left("" + n, 2, "0")
}

/// Скорость: сколько дел в секунду при заданном числе дел и времени.
function rate(дел, мс) {
    if мс <= 0 {
        return 0
    }
    return math.round(дел * 1000.0 / мс)
}
