// crypto — DYPTcrypto: свёртки, коды и шифр на чистом dypt.
//
// Подключение:
//     import "crypto" as crypto
//     print(crypto.sha256_hex("abc"))
//
// Двоичные данные здесь — массив чисел от 0 до 255. Строка переводится
// в такой массив через utf8_bytes и обратно через utf8_text, поэтому
// с русским текстом всё считается так же, как с латиницей.
//
// Модуль написан на самом dypt: ни системных библиотек, ни FFI. Собранная
// через --exe или --native программа остаётся самодостаточной.
//
// О скорости: свёртка идёт примерно мегабайт за несколько секунд под VM
// и заметно быстрее в собранном файле. Для паролей, подписей запросов
// и проверки целостности этого достаточно; шифровать гигабайты — нет.

// --------------------------------------------------------------- разряды

/// Побитовое «исключающее или»: своего действия в языке нет, но оно
/// выражается через «или» и «и».
function _cr_xor(a, b) {
    return or(a, b) - and(a, b)
}

/// Поворот 32-разрядного слова вправо.
function _cr_rotr(x, n) {
    return or(shr(x, n), and(shl(x, 32 - n), 4294967295))
}

/// Поворот 32-разрядного слова влево.
function _cr_rotl(x, n) {
    return or(and(shl(x, n), 4294967295), shr(x, 32 - n))
}

// ----------------------------------------------------------------- байты

/// Строка в массив байтов UTF-8.
function utf8_bytes(text) {
    out = []
    n = length(text)
    i = 0
    while i < n {
        c = ord(text[i])
        if c < 128 {
            push(out, c)
        } elif c < 2048 {
            push(out, 192 + c / 64)
            push(out, 128 + c % 64)
        } elif c < 65536 {
            push(out, 224 + c / 4096)
            push(out, 128 + (c / 64) % 64)
            push(out, 128 + c % 64)
        } else {
            push(out, 240 + c / 262144)
            push(out, 128 + (c / 4096) % 64)
            push(out, 128 + (c / 64) % 64)
            push(out, 128 + c % 64)
        }
        i = i + 1
    }
    return out
}

/// Массив байтов UTF-8 обратно в строку. Испорченный байт заменяется
/// знаком замены, как это принято у разборщиков UTF-8.
function utf8_text(bytes) {
    out = ""
    n = length(bytes)
    i = 0
    while i < n {
        b = bytes[i]
        if b < 128 {
            out = out + chr(b)
            i = i + 1
        } elif b >= 192 and b < 224 and i + 1 < n {
            out = out + chr((b - 192) * 64 + (bytes[i + 1] % 64))
            i = i + 2
        } elif b >= 224 and b < 240 and i + 2 < n {
            out = out + chr((b - 224) * 4096 + (bytes[i + 1] % 64) * 64 + (bytes[i + 2] % 64))
            i = i + 3
        } elif b >= 240 and b < 248 and i + 3 < n {
            код = (b - 240) * 262144 + (bytes[i + 1] % 64) * 4096 + (bytes[i + 2] % 64) * 64 + (bytes[i + 3] % 64)
            if код > 1114111 {
                out = out + chr(65533)
            } else {
                out = out + chr(код)
            }
            i = i + 4
        } else {
            out = out + chr(65533)
            i = i + 1
        }
    }
    return out
}

/// Байты в шестнадцатеричную запись строчными буквами.
function hex_encode(bytes) {
    цифры = "0123456789abcdef"
    out = ""
    i = 0
    n = length(bytes)
    while i < n {
        b = and(bytes[i], 255)
        out = out + цифры[b / 16] + цифры[b % 16]
        i = i + 1
    }
    return out
}

function _cr_hex_digit(c) {
    k = ord(c)
    if k >= 48 and k <= 57 {
        return k - 48
    }
    if k >= 97 and k <= 102 {
        return k - 87
    }
    if k >= 65 and k <= 70 {
        return k - 55
    }
    return -1
}

/// Шестнадцатеричная запись обратно в байты; null, если запись негодная.
function hex_decode(text) {
    n = length(text)
    if n % 2 != 0 {
        return null
    }
    out = []
    i = 0
    while i < n {
        старший = _cr_hex_digit(text[i])
        младший = _cr_hex_digit(text[i + 1])
        if старший < 0 or младший < 0 {
            return null
        }
        push(out, старший * 16 + младший)
        i = i + 2
    }
    return out
}

function _cr_b64(bytes, алфавит, добивать) {
    out = ""
    n = length(bytes)
    i = 0
    while i + 2 < n {
        v = bytes[i] * 65536 + bytes[i + 1] * 256 + bytes[i + 2]
        out = out + алфавит[v / 262144] + алфавит[(v / 4096) % 64] + алфавит[(v / 64) % 64] + алфавит[v % 64]
        i = i + 3
    }
    осталось = n - i
    if осталось == 1 {
        v = bytes[i] * 16
        out = out + алфавит[v / 64] + алфавит[v % 64]
        if добивать {
            out = out + "=="
        }
    } elif осталось == 2 {
        v = bytes[i] * 1024 + bytes[i + 1] * 4
        out = out + алфавит[v / 4096] + алфавит[(v / 64) % 64] + алфавит[v % 64]
        if добивать {
            out = out + "="
        }
    }
    return out
}

/// Байты в base64 с добиванием знаком «=».
function base64_encode(bytes) {
    return _cr_b64(bytes, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", true)
}

/// То же, но алфавитом для адресов и без добивания.
function base64url_encode(bytes) {
    return _cr_b64(bytes, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", false)
}

function _cr_b64_digit(c) {
    k = ord(c)
    if k >= 65 and k <= 90 {
        return k - 65
    }
    if k >= 97 and k <= 122 {
        return k - 71
    }
    if k >= 48 and k <= 57 {
        return k + 4
    }
    if c == "+" or c == "-" {
        return 62
    }
    if c == "/" or c == "_" {
        return 63
    }
    return -1
}

/// base64 обратно в байты. Понимает оба алфавита и запись без добивания;
/// null, если попался посторонний знак.
function base64_decode(text) {
    out = []
    накопитель = 0
    разрядов = 0
    n = length(text)
    i = 0
    while i < n {
        c = text[i]
        i = i + 1
        if c == "=" or c == "\n" or c == "\r" or c == " " or c == "\t" {
            continue
        }
        v = _cr_b64_digit(c)
        if v < 0 {
            return null
        }
        накопитель = and(накопитель * 64 + v, 16777215)
        разрядов = разрядов + 6
        if разрядов >= 8 {
            разрядов = разрядов - 8
            push(out, and(shr(накопитель, разрядов), 255))
        }
    }
    return out
}

// ------------------------------------------------------------- дополнение

function _cr_push_be(out, w) {
    push(out, and(shr(w, 24), 255))
    push(out, and(shr(w, 16), 255))
    push(out, and(shr(w, 8), 255))
    push(out, and(w, 255))
    return null
}

function _cr_push_le(out, w) {
    push(out, and(w, 255))
    push(out, and(shr(w, 8), 255))
    push(out, and(shr(w, 16), 255))
    push(out, and(shr(w, 24), 255))
    return null
}

/// Дополнение сообщения по правилу Меркла — Дамгора: знак 0x80, нули
/// и длина в битах восемью байтами. Порядок байтов длины задаётся:
/// старшим вперёд у SHA, младшим — у MD5.
function _cr_padded(bytes, старшим_вперёд) {
    n = length(bytes)
    out = slice(bytes, 0, n)
    push(out, 128)
    while length(out) % 64 != 56 {
        push(out, 0)
    }
    низ = and(n * 8, 4294967295)
    верх = shr(n, 29)
    if старшим_вперёд {
        _cr_push_be(out, верх)
        _cr_push_be(out, низ)
    } else {
        _cr_push_le(out, низ)
        _cr_push_le(out, верх)
    }
    return out
}

// ---------------------------------------------------------------- SHA-256

_cr_K256 = [
    1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993,
    2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987,
    1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774,
    264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711,
    113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291,
    1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411,
    3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218,
    1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424,
    2428436474, 2756734187, 3204031479, 3329325298
]

/// Свёртка SHA-256: принимает массив байтов, отдаёт 32 байта.
function sha256(bytes) {
    msg = _cr_padded(bytes, true)
    h0 = 1779033703
    h1 = 3144134277
    h2 = 1013904242
    h3 = 2773480762
    h4 = 1359893119
    h5 = 2600822924
    h6 = 528734635
    h7 = 1541459225
    w = []
    i = 0
    while i < 64 {
        push(w, 0)
        i = i + 1
    }
    всего = length(msg)
    место = 0
    while место < всего {
        t = 0
        while t < 16 {
            b = место + t * 4
            w[t] = msg[b] * 16777216 + msg[b + 1] * 65536 + msg[b + 2] * 256 + msg[b + 3]
            t = t + 1
        }
        while t < 64 {
            x = w[t - 15]
            s0 = _cr_xor(_cr_xor(_cr_rotr(x, 7), _cr_rotr(x, 18)), shr(x, 3))
            y = w[t - 2]
            s1 = _cr_xor(_cr_xor(_cr_rotr(y, 17), _cr_rotr(y, 19)), shr(y, 10))
            w[t] = and(w[t - 16] + s0 + w[t - 7] + s1, 4294967295)
            t = t + 1
        }
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        hh = h7
        i = 0
        while i < 64 {
            S1 = _cr_xor(_cr_xor(_cr_rotr(e, 6), _cr_rotr(e, 11)), _cr_rotr(e, 25))
            ch = _cr_xor(and(e, f), and(4294967295 - e, g))
            t1 = and(hh + S1 + ch + _cr_K256[i] + w[i], 4294967295)
            S0 = _cr_xor(_cr_xor(_cr_rotr(a, 2), _cr_rotr(a, 13)), _cr_rotr(a, 22))
            maj = _cr_xor(_cr_xor(and(a, b), and(a, c)), and(b, c))
            t2 = and(S0 + maj, 4294967295)
            hh = g
            g = f
            f = e
            e = and(d + t1, 4294967295)
            d = c
            c = b
            b = a
            a = and(t1 + t2, 4294967295)
            i = i + 1
        }
        h0 = and(h0 + a, 4294967295)
        h1 = and(h1 + b, 4294967295)
        h2 = and(h2 + c, 4294967295)
        h3 = and(h3 + d, 4294967295)
        h4 = and(h4 + e, 4294967295)
        h5 = and(h5 + f, 4294967295)
        h6 = and(h6 + g, 4294967295)
        h7 = and(h7 + hh, 4294967295)
        место = место + 64
    }
    out = []
    _cr_push_be(out, h0)
    _cr_push_be(out, h1)
    _cr_push_be(out, h2)
    _cr_push_be(out, h3)
    _cr_push_be(out, h4)
    _cr_push_be(out, h5)
    _cr_push_be(out, h6)
    _cr_push_be(out, h7)
    return out
}

/// SHA-256 от строки, ответ шестнадцатеричной записью.
function sha256_hex(text) {
    return hex_encode(sha256(utf8_bytes(text)))
}

// ------------------------------------------------------------------ SHA-1

/// Свёртка SHA-1: 20 байтов. Годится для совместимости со старыми
/// службами; для новых подписей берите SHA-256.
function sha1(bytes) {
    msg = _cr_padded(bytes, true)
    h0 = 1732584193
    h1 = 4023233417
    h2 = 2562383102
    h3 = 271733878
    h4 = 3285377520
    w = []
    i = 0
    while i < 80 {
        push(w, 0)
        i = i + 1
    }
    всего = length(msg)
    место = 0
    while место < всего {
        t = 0
        while t < 16 {
            b = место + t * 4
            w[t] = msg[b] * 16777216 + msg[b + 1] * 65536 + msg[b + 2] * 256 + msg[b + 3]
            t = t + 1
        }
        while t < 80 {
            x = _cr_xor(_cr_xor(w[t - 3], w[t - 8]), _cr_xor(w[t - 14], w[t - 16]))
            w[t] = _cr_rotl(x, 1)
            t = t + 1
        }
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        i = 0
        f = 0
        k = 0
        while i < 80 {
            if i < 20 {
                f = or(and(b, c), and(4294967295 - b, d))
                k = 1518500249
            } elif i < 40 {
                f = _cr_xor(_cr_xor(b, c), d)
                k = 1859775393
            } elif i < 60 {
                f = or(or(and(b, c), and(b, d)), and(c, d))
                k = 2400959708
            } else {
                f = _cr_xor(_cr_xor(b, c), d)
                k = 3395469782
            }
            tmp = and(_cr_rotl(a, 5) + f + e + k + w[i], 4294967295)
            e = d
            d = c
            c = _cr_rotl(b, 30)
            b = a
            a = tmp
            i = i + 1
        }
        h0 = and(h0 + a, 4294967295)
        h1 = and(h1 + b, 4294967295)
        h2 = and(h2 + c, 4294967295)
        h3 = and(h3 + d, 4294967295)
        h4 = and(h4 + e, 4294967295)
        место = место + 64
    }
    out = []
    _cr_push_be(out, h0)
    _cr_push_be(out, h1)
    _cr_push_be(out, h2)
    _cr_push_be(out, h3)
    _cr_push_be(out, h4)
    return out
}

/// SHA-1 от строки шестнадцатеричной записью.
function sha1_hex(text) {
    return hex_encode(sha1(utf8_bytes(text)))
}

// -------------------------------------------------------------------- MD5

_cr_T_MD5 = [
    3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426,
    2821735955, 4249261313, 1770035416, 2336552879, 4294925233, 2304563134,
    1804603682, 4254626195, 2792965006, 1236535329, 4129170786, 3225465664,
    643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
    568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512,
    1735328473, 2368359562, 4294588738, 2272392833, 1839030562, 4259657740,
    2763975236, 1272893353, 4139469664, 3200236656, 681279174, 3936430074,
    3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
    4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690,
    4293915773, 2240044497, 1873313359, 4264355552, 2734768916, 1309151649,
    4149444226, 3174756917, 718787259, 3951481745
]

_cr_S_MD5 = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

/// Свёртка MD5: 16 байтов. Для подписей она давно не годится — держите
/// её для проверки целостности и для старых служб, которые просят именно её.
function md5(bytes) {
    msg = _cr_padded(bytes, false)
    a0 = 1732584193
    b0 = 4023233417
    c0 = 2562383102
    d0 = 271733878
    m = []
    i = 0
    while i < 16 {
        push(m, 0)
        i = i + 1
    }
    всего = length(msg)
    место = 0
    while место < всего {
        t = 0
        while t < 16 {
            b = место + t * 4
            m[t] = msg[b] + msg[b + 1] * 256 + msg[b + 2] * 65536 + msg[b + 3] * 16777216
            t = t + 1
        }
        a = a0
        b = b0
        c = c0
        d = d0
        i = 0
        f = 0
        g = 0
        while i < 64 {
            if i < 16 {
                f = or(and(b, c), and(4294967295 - b, d))
                g = i
            } elif i < 32 {
                f = or(and(d, b), and(4294967295 - d, c))
                g = (5 * i + 1) % 16
            } elif i < 48 {
                f = _cr_xor(_cr_xor(b, c), d)
                g = (3 * i + 5) % 16
            } else {
                f = _cr_xor(c, or(b, 4294967295 - d))
                g = (7 * i) % 16
            }
            f = and(f + a + _cr_T_MD5[i] + m[g], 4294967295)
            a = d
            d = c
            c = b
            b = and(b + _cr_rotl(f, _cr_S_MD5[i]), 4294967295)
            i = i + 1
        }
        a0 = and(a0 + a, 4294967295)
        b0 = and(b0 + b, 4294967295)
        c0 = and(c0 + c, 4294967295)
        d0 = and(d0 + d, 4294967295)
        место = место + 64
    }
    out = []
    _cr_push_le(out, a0)
    _cr_push_le(out, b0)
    _cr_push_le(out, c0)
    _cr_push_le(out, d0)
    return out
}

/// MD5 от строки шестнадцатеричной записью.
function md5_hex(text) {
    return hex_encode(md5(utf8_bytes(text)))
}

// ----------------------------------------------------------------- CRC-32

_cr_crc_table = null

function _cr_crc_init() {
    таблица = []
    n = 0
    while n < 256 {
        c = n
        k = 0
        while k < 8 {
            if c % 2 == 1 {
                c = _cr_xor(3988292384, shr(c, 1))
            } else {
                c = shr(c, 1)
            }
            k = k + 1
        }
        push(таблица, c)
        n = n + 1
    }
    _cr_crc_table = таблица
    return null
}

/// Проверочный код CRC-32 — тот же, что в zip и png. Это не свёртка для
/// подписи: подобрать данные под нужный код проще простого.
function crc32(bytes) {
    if _cr_crc_table == null {
        _cr_crc_init()
    }
    c = 4294967295
    i = 0
    n = length(bytes)
    while i < n {
        c = _cr_xor(_cr_crc_table[and(_cr_xor(c, bytes[i]), 255)], shr(c, 8))
        i = i + 1
    }
    return _cr_xor(c, 4294967295)
}

/// CRC-32 от строки.
function crc32_text(text) {
    return crc32(utf8_bytes(text))
}

// ------------------------------------------------------------------- HMAC

/// Подпись HMAC-SHA-256: ключ и сообщение — массивы байтов, ответ — 32 байта.
function hmac_sha256(key, message) {
    k = key
    if length(k) > 64 {
        k = sha256(k)
    }
    длина_ключа = length(k)
    внутри = []
    снаружи = []
    i = 0
    while i < 64 {
        b = 0
        if i < длина_ключа {
            b = k[i]
        }
        push(внутри, _cr_xor(b, 54))
        push(снаружи, _cr_xor(b, 92))
        i = i + 1
    }
    i = 0
    n = length(message)
    while i < n {
        push(внутри, message[i])
        i = i + 1
    }
    середина = sha256(внутри)
    i = 0
    while i < 32 {
        push(снаружи, середина[i])
        i = i + 1
    }
    return sha256(снаружи)
}

/// HMAC-SHA-256 от строк, ответ шестнадцатеричной записью.
function hmac_sha256_hex(key, message) {
    return hex_encode(hmac_sha256(utf8_bytes(key), utf8_bytes(message)))
}

// ----------------------------------------------------------------- PBKDF2

/// Ключ из пароля по PBKDF2-HMAC-SHA-256. Витков берите не меньше
/// десятка тысяч; каждый виток — это две свёртки, так что время растёт
/// прямо пропорционально их числу.
function pbkdf2_sha256(password, salt, витков, длина) {
    ключ = utf8_bytes(password)
    соль = utf8_bytes(salt)
    out = []
    блок = 1
    while length(out) < длина {
        начало = slice(соль, 0, length(соль))
        push(начало, and(shr(блок, 24), 255))
        push(начало, and(shr(блок, 16), 255))
        push(начало, and(shr(блок, 8), 255))
        push(начало, and(блок, 255))
        u = hmac_sha256(ключ, начало)
        итог = slice(u, 0, 32)
        виток = 1
        while виток < витков {
            u = hmac_sha256(ключ, u)
            i = 0
            while i < 32 {
                итог[i] = _cr_xor(итог[i], u[i])
                i = i + 1
            }
            виток = виток + 1
        }
        i = 0
        while i < 32 and length(out) < длина {
            push(out, итог[i])
            i = i + 1
        }
        блок = блок + 1
    }
    return out
}

/// Ключ ChaCha20 из пароля: ровно 32 байта через PBKDF2.
function key_from_password(password, salt, витков) {
    return pbkdf2_sha256(password, salt, витков, 32)
}

// --------------------------------------------------------------- ChaCha20

function _cr_qr(s, a, b, c, d) {
    s[a] = and(s[a] + s[b], 4294967295)
    s[d] = _cr_rotl(_cr_xor(s[d], s[a]), 16)
    s[c] = and(s[c] + s[d], 4294967295)
    s[b] = _cr_rotl(_cr_xor(s[b], s[c]), 12)
    s[a] = and(s[a] + s[b], 4294967295)
    s[d] = _cr_rotl(_cr_xor(s[d], s[a]), 8)
    s[c] = and(s[c] + s[d], 4294967295)
    s[b] = _cr_rotl(_cr_xor(s[b], s[c]), 7)
    return null
}

function _cr_le_word(bytes, i) {
    return bytes[i] + bytes[i + 1] * 256 + bytes[i + 2] * 65536 + bytes[i + 3] * 16777216
}

/// Шестьдесят четыре байта гаммы для одного значения счётчика.
function _cr_chacha_block(key, nonce, счётчик) {
    состояние = [1634760805, 857760878, 2036477234, 1797285236]
    i = 0
    while i < 8 {
        push(состояние, _cr_le_word(key, i * 4))
        i = i + 1
    }
    push(состояние, and(счётчик, 4294967295))
    i = 0
    while i < 3 {
        push(состояние, _cr_le_word(nonce, i * 4))
        i = i + 1
    }
    рабочее = slice(состояние, 0, 16)
    круг = 0
    while круг < 10 {
        _cr_qr(рабочее, 0, 4, 8, 12)
        _cr_qr(рабочее, 1, 5, 9, 13)
        _cr_qr(рабочее, 2, 6, 10, 14)
        _cr_qr(рабочее, 3, 7, 11, 15)
        _cr_qr(рабочее, 0, 5, 10, 15)
        _cr_qr(рабочее, 1, 6, 11, 12)
        _cr_qr(рабочее, 2, 7, 8, 13)
        _cr_qr(рабочее, 3, 4, 9, 14)
        круг = круг + 1
    }
    гамма = []
    i = 0
    while i < 16 {
        _cr_push_le(гамма, and(рабочее[i] + состояние[i], 4294967295))
        i = i + 1
    }
    return гамма
}

/// Шифр ChaCha20. Ключ — 32 байта, оказия (nonce) — 12 байтов, счётчик
/// обычно 0. Расшифровка — тот же вызов с теми же ключом, оказией
/// и счётчиком: шифр складывает данные с гаммой, а сложение обратимо.
///
/// Оказию держать в тайне не нужно, но повторять её с тем же ключом
/// нельзя: два сообщения на одной гамме раскрывают оба. Целостность шифр
/// не проверяет — подпишите шифротекст через hmac_sha256, если важно, что
/// его не подменили.
function chacha20(key, nonce, счётчик, data) {
    if length(key) != 32 or length(nonce) != 12 {
        return null
    }
    out = []
    n = length(data)
    i = 0
    номер = счётчик
    while i < n {
        гамма = _cr_chacha_block(key, nonce, номер)
        k = 0
        while k < 64 and i < n {
            push(out, _cr_xor(data[i], гамма[k]))
            k = k + 1
            i = i + 1
        }
        номер = номер + 1
    }
    return out
}

// ---------------------------------------------------------------- мелочи

/// Побайтовое «исключающее или» двух массивов; длина — по короткому.
function xor_bytes(a, b) {
    n = length(a)
    if length(b) < n {
        n = length(b)
    }
    out = []
    i = 0
    while i < n {
        push(out, _cr_xor(a[i], b[i]))
        i = i + 1
    }
    return out
}

/// Сравнение за одинаковое время: не выходит на первом же несовпадении,
/// поэтому по времени ответа нельзя угадывать подпись знак за знаком.
function equal_bytes(a, b) {
    if length(a) != length(b) {
        return false
    }
    разница = 0
    i = 0
    n = length(a)
    while i < n {
        разница = or(разница, _cr_xor(a[i], b[i]))
        i = i + 1
    }
    return разница == 0
}
