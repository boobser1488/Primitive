// text — разметка текста для вывода.
//
// Подключение:
//     import "text" as text
//     print(text.table([["имя", "лет"], ["Аня", "30"]]))
//
// Всё считается по символам, а не по байтам: в кириллице буква занимает
// два байта, и выравнивание по байтам разъезжалось бы.

import "strings" as strings
import "math" as math

/// Разбивает на слова по пробелам, пропуская пустые промежутки.
function words(s) {
    итог = []
    текущее = ""
    i = 0
    n = length(s)
    while i < n {
        c = s[i]
        if c == " " or c == "\t" or c == "\n" or c == "\r" {
            if strings.size(текущее) > 0 {
                push(итог, текущее)
                текущее = ""
            }
        } else {
            текущее = текущее + c
        }
        i = i + 1
    }
    if strings.size(текущее) > 0 {
        push(итог, текущее)
    }
    return итог
}

/// Разбивает на строки по переводу строки. Возврат каретки отбрасывается.
function lines(s) {
    итог = []
    куски = split(replace(s, "\r", ""), "\n")
    i = 0
    while i < length(куски) {
        push(итог, куски[i])
        i = i + 1
    }
    return итог
}

/// Переносит текст так, чтобы ни одна строка не была длиннее width.
/// Слово длиннее ширины не режется: лучше вылезти, чем сломать слово.
function wrap(s, width) {
    итог = []
    строка = ""
    все = words(s)
    i = 0
    while i < length(все) {
        слово = все[i]
        if strings.size(строка) == 0 {
            строка = слово
        } else {
            if strings.size(строка) + 1 + strings.size(слово) <= width {
                строка = строка + " " + слово
            } else {
                push(итог, строка)
                строка = слово
            }
        }
        i = i + 1
    }
    if strings.size(строка) > 0 {
        push(итог, строка)
    }
    return итог
}

/// Дописывает отступ в начало каждой строки.
function indent(s, отступ) {
    куски = lines(s)
    итог = []
    i = 0
    while i < length(куски) {
        push(итог, отступ + куски[i])
        i = i + 1
    }
    return join(итог, "\n")
}

/// Ставит текст по середине поля ширины width.
function center(s, width) {
    длина = strings.size(s)
    if длина >= width {
        return s
    }
    слева = (width - длина) / 2
    справа = width - длина - слева
    return strings.repeat(" ", слева) + s + strings.repeat(" ", справа)
}

/// Ширина каждого столбца: длина самой длинной ячейки в нём.
function _ширины(строки) {
    ширины = []
    i = 0
    while i < length(строки) {
        j = 0
        while j < length(строки[i]) {
            ш = strings.size(строки[i][j])
            if j >= length(ширины) {
                push(ширины, ш)
            } else {
                if ш > ширины[j] {
                    set(ширины, j, ш)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return ширины
}

/// Ровная таблица: столбцы выравниваются по самой длинной ячейке.
/// Первая строка считается заголовком и отчёркивается.
function table(строки) {
    if length(строки) == 0 {
        return ""
    }
    ширины = _ширины(строки)
    вывод = []
    i = 0
    while i < length(строки) {
        ячейки = []
        j = 0
        while j < length(строки[i]) {
            push(ячейки, strings.pad_right(строки[i][j], ширины[j], " "))
            j = j + 1
        }
        push(вывод, strings.trim_right(join(ячейки, "  ")))
        if i == 0 {
            черта = []
            k = 0
            while k < length(ширины) {
                push(черта, strings.repeat("-", ширины[k]))
                k = k + 1
            }
            push(вывод, join(черта, "  "))
        }
        i = i + 1
    }
    return join(вывод, "\n")
}

/// Число с разделением разрядов: 1234567 превращается в «1 234 567».
function grouped(n, разделитель) {
    отрицательное = n < 0
    if отрицательное {
        n = -n
    }
    цифры = "" + n
    итог = ""
    i = strings.size(цифры)
    счёт = 0
    while i > 0 {
        итог = цифры[i - 1] + итог
        счёт = счёт + 1
        i = i - 1
        if счёт % 3 == 0 and i > 0 {
            итог = разделитель + итог
        }
    }
    if отрицательное {
        return "-" + итог
    }
    return итог
}

/// Полоса-указатель заполненности: доля от 0 до 1 в поле ширины width.
function bar(доля, width) {
    if доля < 0 {
        доля = 0
    }
    if доля > 1 {
        доля = 1
    }
    занято = math.trunc(доля * width)
    return strings.repeat("#", занято) + strings.repeat(".", width - занято)
}
