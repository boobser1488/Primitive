// test — простая основа для проверок.
//
// Подключение:
//     import "test" as test
//     test.equal("сложение", 2 + 2, 4)
//     test.report()
//
// Каждая проверка печатает строку только при несовпадении, а в конце
// report() подводит итог и говорит, всё ли сошлось. Возвращаемое им
// значение годится для exit(), чтобы прогон сообщал об исходе кодом
// завершения.

_всего = 0
_ошибок = 0
_имя_набора = ""

/// Название набора проверок: печатается заголовком.
function suite(имя) {
    _имя_набора = имя
    print("== " + имя + " ==")
    return null
}

function _отметить(ок, что, подробности) {
    _всего = _всего + 1
    if ок {
        return true
    }
    _ошибок = _ошибок + 1
    print("  НЕ СОШЛОСЬ: " + что)
    if подробности != "" {
        print("    " + подробности)
    }
    return false
}

/// Значения должны совпасть.
function equal(что, получено, ожидалось) {
    return _отметить(
        получено == ожидалось,
        что,
        "получено " + получено + ", ожидалось " + ожидалось
    )
}

/// Значения должны различаться.
function not_equal(что, получено, ожидалось) {
    return _отметить(получено != ожидалось, что, "оба равны " + получено)
}

/// Условие должно быть истинным.
function ok(что, условие) {
    return _отметить(условие, что, "условие ложно")
}

/// Условие должно быть ложным.
function not_ok(что, условие) {
    return _отметить(not условие, что, "условие истинно")
}

/// Число должно попасть в промежуток [low, high] — оба края входят.
function between(что, получено, low, high) {
    return _отметить(
        получено >= low and получено <= high,
        что,
        "получено " + получено + ", ждали от " + low + " до " + high
    )
}

/// Строка должна содержать кусок.
function contains_text(что, где, кусок) {
    return _отметить(
        contains(где, кусок),
        что,
        "в «" + где + "» нет «" + кусок + "»"
    )
}

/// Работа должна оборваться исключением. Работа зовётся без доводов.
function raises(что, работа) {
    сорвалось = false
    try {
        работа()
    } catch (e) {
        сорвалось = true
    }
    return _отметить(сорвалось, что, "работа прошла без ошибки")
}

/// Работа должна пройти без исключения.
function passes(что, работа) {
    прошло = true
    try {
        работа()
    } catch (e) {
        прошло = false
    }
    return _отметить(прошло, что, "работа сорвалась")
}

/// Сколько проверок сделано и сколько из них не сошлось.
function counts() {
    return tuple(_всего, _ошибок)
}

/// Подводит итог. Возвращает 0, если всё сошлось, иначе 1 — этим числом
/// удобно завершать прогон через exit().
function report() {
    if _ошибок == 0 {
        print("Всё сошлось: проверок " + _всего)
        return 0
    }
    print("Не сошлось " + _ошибок + " из " + _всего)
    return 1
}

/// Сбрасывает счётчики: нужно, если в одном прогоне несколько наборов.
function reset() {
    _всего = 0
    _ошибок = 0
    return null
}
