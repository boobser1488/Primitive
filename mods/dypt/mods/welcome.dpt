// Встречает пришедших и считает их — состояние живёт между событиями,
// потому что скриптовый мод не уходит после первого запуска.

всего = 0

function on_load() {
    print("встречающий на посту")
}

function on_join(игрок, имя) {
    всего = всего + 1
    say(имя + " пришёл (" + всего + "-й за эту жизнь сервера)")
    tell(игрок, "добро пожаловать. /dypt list — что тут можно запустить")
}

function on_leave(игрок, имя) {
    say(имя + " ушёл")
}

function on_unload() {
    print("за эту жизнь сервера пришло " + всего)
}
