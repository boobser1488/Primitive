// Бедрок не ломается. Тот же мод, что и greeter на Rust, — семь строк.
//
// on_break вызывается до того, как блок исчезнет, и false означает
// «не давать». Так работает всякое отменяемое событие.

function on_break(игрок, x, y, z, блок) {
    if block_name(блок) == "bedrock" {
        tell(игрок, "бедрок не ломается")
        return false
    }
    return true
}
