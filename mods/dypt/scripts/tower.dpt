// Башня перед игроком: то, ради чего язык внутри игры вообще нужен.
//
//   /dypt tower              — восемь блоков камня
//   /dypt tower 20 dirt      — двадцать блоков земли
//
// Ставится **перед** игроком, а не под ним: башня, выросшая из-под ног,
// поднимает игрока внутрь себя.

доводы = args()
высота = 8
материал = "stone"
if length(доводы) > 0 { высота = tonumber(доводы[0]) }
if length(доводы) > 1 { материал = доводы[1] }

где = pos()
куда = look()

// Три шага по взгляду, но только по горизонтали: смотреть игрок может и
// в небо, а башня нужна рядом, а не над головой.
x = где[0] + куда[0] * 3
z = где[2] + куда[2] * 3
основание = surface(x, z)
if основание == null {
    print("там ещё не загружен мир — подойдите ближе")
} else {
    i = 0
    while i < высота {
        place(x, основание + 1 + i, z, материал)
        i = i + 1
    }
    print("поставил " + высота + " блоков " + материал + " на высоте " + (основание + 1))
}
