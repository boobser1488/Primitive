// Скрипт, который живёт: следит за игроками и говорит, когда кому-то
// плохо. Мод не даёт подписаться на события (почему — в шапке
// src/lib.rs), и вот как это выглядит вместо подписки.
//
//   /dypt watch          — смотреть, пока не /dypt stop
//   /dypt watch 5        — пять кругов и выйти
//
// Обратите внимание на stopped(): без него скрипт с бесконечным циклом
// не остановить ничем, кроме перезапуска сервера.

доводы = args()
кругов = 0
if length(доводы) > 0 { кругов = tonumber(доводы[0]) }

сделано = 0
while true {
    if stopped() { break }
    if кругов > 0 and сделано >= кругов { break }

    for id in players() {
        тело = vitals(id)
        if тело != null {
            if тело["health"] < тело["max_health"] * 0.3 {
                say(player_name(id) + " при смерти: " + тело["health"])
            }
            if тело["hydration"] < 0.2 {
                tell(id, "пить хочется")
            }
        }
    }

    сделано = сделано + 1
    sleep(2000)
}
print("отсмотрел кругов: " + сделано)
