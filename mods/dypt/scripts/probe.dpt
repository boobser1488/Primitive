// Проверка, что мост жив: зовёт по одной функции из разных таблиц и
// печатает, что ответили. Ни одной, которая что-нибудь меняет.
//
//   /dypt probe
//
// Работает и из консоли сервера, где игрока нет вовсе — поэтому здесь
// нет ни pos(), ни vitals(): всё, что по умолчанию берёт «того, кто
// позвал», из консоли ответит отказом, и это правильно.

print("мир: зерно " + world_seed() + ", чанков в памяти " + chunk_count())
точка = spawn_point()
print("точка появления: " + точка[0] + ", " + точка[1] + ", " + точка[2])
print("время " + time() + ", погода " + weather() + ", такт " + tick())

print("блоков в таблице: " + block_count())
камень = block_id("stone")
print("stone = " + камень + ", обратно: " + block_name(камень))
про_камень = block_info(камень)
print("  прочность " + про_камень["hardness"] + ", вес " + про_камень["weight"] + " кг")
print("  голыми руками: " + break_time(камень) + " с")

print("видов животных: " + species_count())
print("рецептов: " + recipe_count())
print("игроков в сети: " + length(players()))

правила = rules()
print("тяжесть " + правила["gravity"] + ", шаг " + правила["walk_speed"] + " м/с")
