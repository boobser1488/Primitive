// Самый маленький скрипт, который что-то знает об игре.
//
//   /dypt hello
//   /dypt hello Иван        — довод придёт в args()

print("привет, " + player_name())

где = pos()
под_ногами = block_at(где[0], где[1] - 1, где[2])
if под_ногами == null {
    print("подо мной незагруженный чанк")
} else {
    print("стою на: " + block_name(под_ногами))
}

доводы = args()
if length(доводы) > 0 {
    print("мне передали: " + join(доводы, ", "))
}

print("такт " + tick() + ", время суток " + time() + ", погода " + weather())
