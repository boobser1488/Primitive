// Язык программирования внутри игры.
//
// RON, а не TOML, по той же причине, что и у остальных модов: в
// `settings` лежат значения, о типах которых хост ничего не знает, а RON
// — запись, в которой типы есть. См. `primitive_modapi::manifest`.
(
    name: "dypt",
    version: "1.0.0",

    // Версия договора, против которой собрана библиотека. Объявлена
    // здесь, а не только возвращается точкой входа, чтобы сервер мог
    // отказать несовместимому моду **не загружая его код**.
    api: (major: 2, minor: 0),

    description: "Выполняет программы на dypt (.dpt, .dyc, .dasm) внутри мира",
    authors: ["Primitive"],
    enabled: true,

    // Auto выясняет имя файла из имени мода и платформы: dypt.dll,
    // libdypt.so, libdypt.dylib.
    library: Auto,

    dependencies: [],
    load_after: [],
    resources: [],

    settings: {
        // Библиотека самого языка, рядом с этим файлом. Не мод: мод —
        // это `dypt.dll` выше, а это `dypt_embed.dll`, собранная из
        // репозитория dypt. Две библиотеки, а не одна, потому что игра
        // не должна переставать собираться на машине, где каталога с
        // dypt нет.
        "runtime": Text("dypt_embed.dll"),

        // Откуда берутся разовые скрипты — те, что запускают руками
        // через /dypt. Путь относительно папки мода.
        "scripts": Text("scripts"),

        // ...а откуда — скриптовые моды: те, что загружаются при
        // старте, живут постоянно и ловят события. Две папки, а не
        // одна, потому что это два разных рода: разовый скрипт
        // запускают, когда он нужен, а мод не спрашивает.
        "mods": Text("mods"),

        // Каталог стандартной библиотеки dypt (`math`, `strings`,
        // `json`...). Кладётся в переменную окружения DYPT_LIB при
        // загрузке: сам язык ищет `lib` рядом со своим исполняемым
        // файлом, а исполняемый файл здесь — сервер игры.
        "lib": Text("lib"),

        // Кому можно запускать. **По умолчанию только операторам**, и
        // это не осторожность, а прямое следствие того, что скрипт
        // умеет: `command()` выполняет любую серверную команду с
        // правами оператора. Открыть это всем — значит раздать права
        // оператора всем.
        "operators_only": Bool(true),

        // Сколько секунд скрипту позволено идти. По истечении первый же
        // его вызов в игру отвечает отказом, и скрипт падает на нём.
        // Ноль — не ограничивать (цикл без вызовов в игру не остановит
        // и это; см. README).
        "limit_seconds": I64(30),

        // Сколько миллисекунд ждать ответа обработчика события.
        // Ждёт **тактовый цикл сервера**, поэтому число маленькое: за
        // этим сроком мод объявляет поток скриптов потерянным и
        // выключает доставку событий целиком, потому что стучаться в
        // зависший поток — значит класть по секунде на каждое событие
        // в мире. Возвращает к жизни /dypt reload.
        "handler_ms": I64(1000),

        // Что выполнить при старте сервера — разовым скриптом. Пусто —
        // ничего. К скриптовым модам отношения не имеет: они грузятся
        // всегда.
        "autorun": Text(""),
    },
)
